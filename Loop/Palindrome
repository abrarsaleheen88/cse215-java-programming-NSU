import java.util.Scanner;
class Main {
    public static void main(String[] args) {



        Scanner s = new Scanner(System.in);

        System.out.println ("Enter a number");

        int n = s.nextInt();

        int pal =0;
        int r;

        
        while ( n != 0)
            {
                   r = n %10;
                     pal = r +( pal * 10);
                   n = n/10;
                
            }

         System.out.println(pal);
        
    }
}
