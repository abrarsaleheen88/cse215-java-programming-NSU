import java.util.Scanner;
class Main {
    public static void main(String[] args) {

        Scanner s = new Scanner(System.in);

      
       float sum = 0.0f;
        float avg  = 0.0f;
        int i  = 0;
       
        int pos =0;
        int neg = 0;
        while (true)
            {
                    System.out.print("Enter an number =");
                  int  input  = s.nextInt();
                if (input > 0)
                {
                    pos ++;
                     i++;
                }
          else if (input <0)
          {

              neg ++;
               i++;
          }

                else {

                    break;
                }
             sum = sum+ (float)input;
            
                
               
            }

        avg  =  sum /i;
        System.out.print("Total positive = " + pos );
         System.out.print("Total negative = " + neg );
         System.out.print("Total= " + sum );
         System.out.print("Total average = " + avg );
        
    }
}
