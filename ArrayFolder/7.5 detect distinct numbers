import java.util.Scanner;
class Main {
    public static void main(String[] args) {

        Scanner s = new Scanner(System.in);
    int []arr = new int[10];
        for(int i=0;i<arr.length;i++)
            {
                arr[i]= s.nextInt();
            }

      for(int i=0;i<arr.length;i++)
            {
             int    take = arr[i];
            boolean isUnique = false;

                for (int j=0;j<i;j++)
                    {

                        if (take == arr[j])
                        {
                            isUnique = true;
                            break;
                        }
                    }                

                if (isUnique)
                {
                    continue;
                }

                System.out.print(take+",");
            }

        

        
        
    }
}
