import java.util.Scanner;
class Main {
    public static void main(String[] args) 
    {
        Scanner  s = new Scanner(System.in);

      //  int n = s.nextInt();
        int arr[][] = new int [4][4];

            for(int i = 0 ;i<4;i++)
                {
                   
                        for (int j=0;j<4;j++)
                                {
                                       arr[i][j] = s.nextInt(); 
                                }
                        
                }

        
        for(int i = 0 ;i<4;i++)
                {
                                int sum = 0;
                        for (int j=0;j<4;j++)
                                {
                                        sum += arr[j][i];
                                }

                         System.out.println(i +","+sum);
                }
            
    }

       
}
