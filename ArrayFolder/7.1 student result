import java.util.Scanner;
class Main {
    public static void main(String[] args) {

        Scanner s = new Scanner(System.in);

       
        System.out.println ("Enter total students");
          int size  =  s.nextInt();


        int [] n = new int[size];

        for (int i =0;i< size ;i++)

            {
                n[i] = s.nextInt();

                
            }


        int max = n[0];

       for (int i =0;i< size ;i++)

            {
                if ( max < n[i])
                {
                    max = n[i];
                }

                
            }


        System.out.print("Highest = "+ max);

         for (int i =0;i< size ;i++)

            {
                if (n[i] >= max-10)
                {
                  System.out.println("Grade A" + n[i]);
                }


               else  if (n[i] >= max-20)
                {
                  System.out.println("Grade B" + n[i]) ;
                }

                else  if (n[i] >= max-30)
                {
                  System.out.println("Grade C" + n[i]);
                }


                else  if (n[i] >= max-40)
                {
                  System.out.println("Grade D" + n[i]);
                }

               else
                {
                  System.out.println("Grade F" + n[i]);
                }
            }
        
    }
}
